<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ScreenCaptureActivity">


    <Button
        android:id="@+id/startButton"
        android:layout_width="213dp"
        android:layout_height="wrap_content"
        android:text="@string/start_recording"
        android:layout_marginTop="25dp" />

    <Button
        android:id="@+id/stopButton"
        android:layout_width="215dp"
        android:layout_height="wrap_content"
        android:text="@string/stop_recording"
        android:layout_marginTop="25dp"
        />


    <Button
        android:id="@+id/appearTopButton"
        android:layout_width="213dp"
        android:layout_height="wrap_content"
        android:text="Appear top"
        android:layout_marginTop="25dp" />


    <Button
        android:id="@+id/receiverBtn"
        android:layout_width="213dp"
        android:layout_height="wrap_content"
        android:text="Start receiver"
        android:layout_marginTop="25dp" />

    <Button
        android:id="@+id/notiServiceBtn"
        android:layout_width="213dp"
        android:layout_height="wrap_content"
        android:text="Notification listen"
        android:layout_marginTop="25dp" />

    <Button
        android:id="@+id/permissionBtn"
        android:layout_width="213dp"
        android:layout_height="wrap_content"
        android:text="Permission"
        android:layout_marginTop="25dp" />

</LinearLayout>
